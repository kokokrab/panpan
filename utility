local function ensureTradingEveryone()
    -- Live SettingsDB mapping: 1 = Everyone, 2 = Friends, 3 = No One.
    local helper = waitFor("Adopt Me settings system", function()
        local ok, value = pcall(function()
            return loadSettingsHelper().get_setting_client({
                setting_id = "trade_requests",
                use_transform = false,
            })
        end)
        return ok and value ~= nil and loadSettingsHelper()
    end, 30)

    helper.set_setting_client({
        setting_id = "trade_requests",
        value = 1,
    })
    callRemote("SettingsAPI/SetSetting", "trade_requests", 1)

    waitFor("Trading setting to verify as Everyone", function()
        local clientRaw = helper.get_setting_client({
            setting_id = "trade_requests",
            use_transform = false,
        })
        local serverRaw = helper.get_setting_server({
            setting_id = "trade_requests",
            use_transform = false,
        })
        local clientText = helper.get_setting_client({
            setting_id = "trade_requests",
            use_transform = true,
        })
        return clientRaw == 1 and serverRaw == 1 and clientText == "Everyone"
    end, 15)
    notify("Trading verified: Everyone")
