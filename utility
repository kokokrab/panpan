    preset18.Position = UDim2.new(0, 198, 0.5, -13)
    preset18.BackgroundColor3 = Color3.fromRGB(38, 46, 64)
    preset18.Font = Enum.Font.GothamBold
    preset18.Text = "18"
    preset18.TextSize = 11
    preset18.TextColor3 = Color3.fromRGB(226, 232, 240)
    preset18.Parent = amountRow
    makeCorner(preset18, 6)

    local sendBtn = Instance.new("TextButton")
    sendBtn.Size = UDim2.new(1, 0, 0, 34)
    sendBtn.Position = UDim2.new(0, 0, 0, 288)
    sendBtn.BackgroundColor3 = Color3.fromRGB(37, 99, 235)
    sendBtn.Font = Enum.Font.GothamBold
    sendBtn.Text = "Send 100 Crystal Eggs"
    sendBtn.TextSize = 13
    sendBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    sendBtn.Parent = body
    makeCorner(sendBtn, 8)
    uiRefs.sendBtn = sendBtn

    local statusLabel = Instance.new("TextLabel")
    statusLabel.Size = UDim2.new(1, 0, 0, 18)
    statusLabel.Position = UDim2.new(0, 0, 1, -18)
    statusLabel.BackgroundTransparency = 1
    statusLabel.Font = Enum.Font.GothamMedium
    statusLabel.Text = state.statusText
    statusLabel.TextSize = 11
    statusLabel.TextColor3 = Color3.fromRGB(205, 214, 230)
    statusLabel.TextTruncate = Enum.TextTruncate.AtEnd
    statusLabel.TextXAlignment = Enum.TextXAlignment.Left
    statusLabel.Parent = body
    uiRefs.statusLabel = statusLabel

    local function parsedAmount()
        local num = math.floor(tonumber(amountBox.Text) or 0)
        return num > 0 and num or DEFAULT_SEND_AMOUNT
    end

    updateActionButtons = function()
        if state.sending then
            sendBtn.Text = "Cancel Send"
            sendBtn.BackgroundColor3 = Color3.fromRGB(220, 38, 38)
        else
            local amt = parsedAmount()
            if state.selectedPlayer then
                sendBtn.Text = ("Send %d to %s"):format(amt, state.selectedPlayer)
                sendBtn.BackgroundColor3 = Color3.fromRGB(37, 99, 235)
            else
                sendBtn.Text = ("Select a User (Send %d)"):format(amt)
                sendBtn.BackgroundColor3 = Color3.fromRGB(51, 65, 85)
            end
        end
    end

    local function rebuildPlayerList()
        for _, item in ipairs(playerList:GetChildren()) do
            if item:IsA("TextButton") or item:IsA("TextLabel") then
                item:Destroy()
            end
        end

        local others = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                table.insert(others, plr)
            end
        end
        table.sort(others, function(a, b)
            return string.lower(a.Name) < string.lower(b.Name)
        end)

        -- Clear selection if selected player left
        if state.selectedPlayer and not Players:FindFirstChild(state.selectedPlayer) then
            state.selectedPlayer = nil
        end
        -- Auto-select if there's only 1 other player
        if not state.selectedPlayer and #others == 1 then
            state.selectedPlayer = others[1].Name
        end

        if #others == 0 then
            local empty = Instance.new("TextLabel")
            empty.Size = UDim2.new(1, 0, 0, 26)
            empty.BackgroundTransparency = 1
            empty.Font = Enum.Font.GothamMedium
            empty.Text = "No other players in server"
            empty.TextSize = 12
            empty.TextColor3 = Color3.fromRGB(100, 116, 139)
            empty.Parent = playerList
        else
            for idx, plr in ipairs(others) do
                local selected = (state.selectedPlayer == plr.Name)
                local row = Instance.new("TextButton")
                row.Name = plr.Name
                row.LayoutOrder = idx
                row.Size = UDim2.new(1, 0, 0, 26)
                row.BackgroundColor3 = selected and Color3.fromRGB(30, 64, 175) or Color3.fromRGB(27, 34, 49)
                row.Font = selected and Enum.Font.GothamBold or Enum.Font.GothamMedium
                row.Text = plr.DisplayName ~= plr.Name
                    and ("  %s (@%s)"):format(plr.DisplayName, plr.Name)
                    or ("  %s"):format(plr.Name)
                row.TextSize = 12
                row.TextColor3 = selected and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(203, 213, 225)
                row.TextXAlignment = Enum.TextXAlignment.Left
                row.TextTruncate = Enum.TextTruncate.AtEnd
                row.Parent = playerList
                makeCorner(row, 6)

                row.MouseButton1Click:Connect(function()
                    state.selectedPlayer = plr.Name
                    rebuildPlayerList()
                    updateActionButtons()
                end)
            end
        end

        updateActionButtons()
    end

    preset100.MouseButton1Click:Connect(function()
        amountBox.Text = "100"
        updateActionButtons()
    end)
    preset18.MouseButton1Click:Connect(function()
        amountBox.Text = "18"
        updateActionButtons()
    end)
    amountBox:GetPropertyChangedSignal("Text"):Connect(function()
        updateActionButtons()
    end)
    refreshBtn.MouseButton1Click:Connect(function()
        rebuildPlayerList()
        refreshEggCounter()
    end)

    sendBtn.MouseButton1Click:Connect(function()
        if state.sending then
            state.cancelSend = true
            setStatus("Cancelling after current batch...", Color3.fromRGB(251, 191, 36))
            return
        end
        if not state.ready then
            setStatus("Still finishing startup...", Color3.fromRGB(251, 191, 36))
            return
        end
        local target = state.selectedPlayer
        local amt = parsedAmount()
        task.spawn(sendCrystalEggs, target, amt)
    end)

    closeBtn.MouseButton1Click:Connect(function()
        if getgenv().AutoTrade and getgenv().AutoTrade.stop then
            getgenv().AutoTrade.stop()
        end
    end)

    table.insert(uiConnections, Players.PlayerAdded:Connect(rebuildPlayerList))
    table.insert(uiConnections, Players.PlayerRemoving:Connect(function()
        task.defer(rebuildPlayerList)
    end))

    rebuildPlayerList()
end

-- Expose global controls
getgenv().AutoTrade = {
    crystalEggCount = crystalEggCount,
    crystalEggIds = crystalEggIds,
    receiveOneTrade = receiveOneTrade,
    sendCrystalEggs = sendCrystalEggs,
    ensureTradingEveryone = ensureTradingEveryone,
    closeStartupPopups = closeStartupPopups,
    closePetDiscoveryApp = closePetDiscoveryApp,
    closeStarterPackPopup = closeStarterPackPopup,
    stop = function()
        getgenv().AutoTradeRunning = false
        state.cancelSend = true
        for _, conn in ipairs(uiConnections) do
            pcall(function() conn:Disconnect() end)
        end
        table.clear(uiConnections)
        if uiRefs.gui then
            pcall(function() uiRefs.gui:Destroy() end)
            uiRefs.gui = nil
        end
        notify("Stopped Crystal Egg Trader")
    end,
}

-- ===================== STARTUP SEQUENCE =====================
buildUI()
setStatus("Clearing startup popups...", Color3.fromRGB(253, 224, 71))

task.spawn(watchLateWorldEntry)
task.spawn(watchLateStarRewardsPopup)
enterWorld()
loadClientData()
closeStartupPopups()

setStatus("Setting Trading = Everyone...", Color3.fromRGB(253, 224, 71))
ensureTradingEveryone()
refreshEggCounter()

state.ready = true
if updateActionButtons then updateActionButtons() end
setStatus("Ready • Trading: Everyone", Color3.fromRGB(134, 239, 172))

-- Live Crystal Egg count updater
task.spawn(function()
    while getgenv().AutoTradeRunning do
        refreshEggCounter()
        task.wait(1.5)
    end
end)

-- Auto-Accept background loop (pauses while actively sending)
task.spawn(function()
    while getgenv().AutoTradeRunning do
        if state.autoAccept and not state.sending then
            local ok, err = pcall(receiveOneTrade)
            if not ok and getgenv().AutoTradeRunning then
                warn("[AutoTrade] Accept error: " .. tostring(err))
                setStatus("Accept error: " .. tostring(err), Color3.fromRGB(248, 113, 113))
                task.wait(2)
            end
        end
        task.wait(0.25)
    end
end)
