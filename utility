local API
local function remote(name)
    API = API or ReplicatedStorage:WaitForChild("API", 30)
    local value = API and API:FindFirstChild(name)
    assert(value, "Missing Adopt Me remote: " .. name)
    return value
end

local function callRemote(name, ...)
    local value = remote(name)
    if value:IsA("RemoteFunction") then return value:InvokeServer(...) end
    value:FireServer(...)
end

local ClientData
local function loadClientData()
    if ClientData then return ClientData end
    local oldIdentity = getthreadidentity and getthreadidentity()
    if setthreadidentity then setthreadidentity(2) end
    local ok, result = pcall(function()
        local LegacyLoad = require(ReplicatedStorage.new.modules.LegacyLoad)
        return LegacyLoad("ClientData")
    end)
    if setthreadidentity and oldIdentity then setthreadidentity(oldIdentity) end
    assert(ok, "Could not load Adopt Me ClientData: " .. tostring(result))
    ClientData = result
    return ClientData
end

local function playerData()
    local data = loadClientData().get_data()
    return data[LocalPlayer.Name] or data, data
end

local function crystalEggIds()
    local ownData = playerData()
    local ids = {}
    for _, category in pairs(ownData.inventory or {}) do
        if type(category) == "table" then
            for inventoryKey, item in pairs(category) do
                if type(item) == "table" and item.kind == EGG_KIND then
                    table.insert(ids, tostring(item.unique_id or item.unique or inventoryKey))
                end
            end
        end
    end
    table.sort(ids)
    return ids
end

local function crystalEggCount()
    return #crystalEggIds()
end

local function refreshEggCounter()
    local ok, count = pcall(crystalEggCount)
    if ok then
        state.eggCount = count
        if uiRefs.eggCountLabel then
