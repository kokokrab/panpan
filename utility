local CachedUIManager
local function loadUIManager()
    if CachedUIManager then return CachedUIManager end
    local oldIdentity = getthreadidentity and getthreadidentity()
    if setthreadidentity then setthreadidentity(2) end
    local ok, result = pcall(function()
        return require(ReplicatedStorage:WaitForChild("Fsys")).load("UIManager")
    end)
    if setthreadidentity and oldIdentity then setthreadidentity(oldIdentity) end
    if ok then CachedUIManager = result end
    return CachedUIManager
end

local function closePetDiscoveryApp()
    local uiMgr = loadUIManager()
    local discGui = LocalPlayer.PlayerGui:FindFirstChild("PetDiscoveryApp")
    local isOpen = false
    if uiMgr and uiMgr.is_visible then
        local oldIdentity = getthreadidentity and getthreadidentity()
        if setthreadidentity then setthreadidentity(2) end
        local ok, vis = pcall(uiMgr.is_visible, "PetDiscoveryApp")
        if setthreadidentity and oldIdentity then setthreadidentity(oldIdentity) end
        if ok and vis then isOpen = true end
    end
    if not isOpen and discGui and discGui:IsA("ScreenGui") and discGui.Enabled then
        isOpen = true
    end
    if not isOpen then return false end

    if uiMgr and uiMgr.set_app_visibility then
        local oldIdentity = getthreadidentity and getthreadidentity()
        if setthreadidentity then setthreadidentity(2) end
        pcall(uiMgr.set_app_visibility, "PetDiscoveryApp", false)
        if setthreadidentity and oldIdentity then setthreadidentity(oldIdentity) end
    end

    task.wait(0.15)
    discGui = LocalPlayer.PlayerGui:FindFirstChild("PetDiscoveryApp")
    if discGui and discGui.Enabled then
        local doneBtn = visibleButtonByText(discGui, "DONE") or visibleButtonByText(discGui, "Done")
        if doneBtn then
            clickWrappedButton(doneBtn)
            physicallyClickButton(doneBtn)
        end
    end
    return true
end

local function closeStarterPackPopup()
    local spGui = LocalPlayer.PlayerGui:FindFirstChild("FTUEStarterPackApp")
    if not spGui or not spGui:IsA("ScreenGui") then return false end

    local closedAny = false
    local uiMgr = loadUIManager()
    local app = uiMgr and uiMgr.apps and uiMgr.apps.FTUEStarterPackApp
    if app and app.splash and app.splash:IsA("GuiObject") and app.splash.Visible then
        app.splash.Visible = false
        closedAny = true
    end

    local popups = spGui:FindFirstChild("Popups")
    if popups then
        for _, childGui in ipairs(popups:GetChildren()) do
            if childGui:IsA("GuiObject") and childGui.Visible then
                local exitBtn = childGui:FindFirstChild("ExitButton", true)
                if exitBtn and (exitBtn:IsA("TextButton") or exitBtn:IsA("ImageButton")) then
                    clickWrappedButton(exitBtn)
                end
                if childGui.Visible then
                    childGui.Visible = false
                end
                closedAny = true
            end
        end
    end

    return closedAny
end

