local function formatNumber(n)
    local str = tostring(math.floor(tonumber(n) or 0))
    local formatted = str:reverse():gsub("(%d%d%d)", "%1,"):reverse()
    return formatted:gsub("^,", "")
end

local function setStatus(text, color)
    state.statusText = tostring(text)
    if uiRefs.statusLabel then
        uiRefs.statusLabel.Text = state.statusText
        if color then
            uiRefs.statusLabel.TextColor3 = color
        else
            uiRefs.statusLabel.TextColor3 = Color3.fromRGB(205, 214, 230)
        end
    end
end

local function notify(text, duration)
    print("[AutoTrade] " .. text)
    pcall(StarterGui.SetCore, StarterGui, "SendNotification", {
        Title = "Crystal Egg Trader",
        Text = text,
        Duration = duration or 5,
    })
end

local function waitFor(label, callback, timeout)
    local deadline = os.clock() + (timeout or DEFAULT_TIMEOUT)
    repeat
        local ok, result = pcall(callback)
        if ok and result then return result end
        task.wait(0.2)
    until os.clock() >= deadline or not getgenv().AutoTradeRunning
    error("Timed out waiting for " .. label)
end

local function child(root, ...)
    local value = root
    for _, name in ipairs({ ... }) do
        value = value and value:FindFirstChild(name)
    end
    return value
end

-- ===================== UI / CLICK HELPERS =====================
local function clickWrappedButton(button)
    if not button then return false end
    for _, signal in ipairs({ button.MouseButton1Click, button.Activated }) do
        for _, connection in ipairs(getconnections(signal)) do
            if connection.Function then
                for _, upvalue in ipairs(getupvalues(connection.Function)) do
                    if type(upvalue) == "table" and type(upvalue.mouse_button1_click) == "function" then
                        upvalue.mouse_button1_click()
                        return true
                    end
                end
            end
        end
    end
    if firesignal then
        local activatedConnections = getconnections(button.Activated)
        if #activatedConnections > 0 then
            firesignal(button.Activated)
            return true
        end
        local clickConnections = getconnections(button.MouseButton1Click)
        if #clickConnections > 0 then
            firesignal(button.MouseButton1Click)
            return true
        end
    end
    for _, signal in ipairs({ button.Activated, button.MouseButton1Click }) do
        local connections = getconnections(signal)
        if connections[1] then
            connections[1]:Fire()
            return true
        end
    end
    return false
end

local function visibleButtonByText(root, text)
    if not root then return nil end
    for _, button in ipairs(root:GetDescendants()) do
        if (button:IsA("TextButton") or button:IsA("ImageButton")) and button.Visible then
            if button:IsA("TextButton") and button.Text == text then return button end
            for _, descendant in ipairs(button:GetDescendants()) do
                if descendant:IsA("TextLabel") and descendant.Visible and descendant.Text == text then
                    return button
                end
            end
        end
    end
end

local function visibleDialogButton(text)
    return visibleButtonByText(LocalPlayer.PlayerGui:FindFirstChild("DialogApp"), text)
end

local function isActuallyVisible(gui)
    local current = gui
    while current and current ~= LocalPlayer.PlayerGui do
        if current:IsA("GuiObject") and not current.Visible then return false end
        if current:IsA("LayerCollector") and not current.Enabled then return false end
        current = current.Parent
    end
    return current == LocalPlayer.PlayerGui
end

local function physicallyClickButton(button)
    if not button or not isActuallyVisible(button) then return false end
    local center = button.AbsolutePosition + button.AbsoluteSize / 2
    local ok = pcall(function()
        VirtualInputManager:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 0)
        task.wait(0.06)
        VirtualInputManager:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 0)
    end)
    return ok
end

local function buttonText(button)
    if button:IsA("TextButton") and button.Text ~= "" then return button.Text end
    for _, descendant in ipairs(button:GetDescendants()) do
        if descendant:IsA("TextLabel") and descendant.Visible and descendant.Text ~= "" then
            return descendant.Text
        end
    end
    return ""
end

local function normalizedGuiText(value)
    return string.gsub(string.lower(tostring(value or "")), "[%s%p]+", "")
end

local function hasNamedAncestor(instance, fragment)
    local current = instance
    fragment = string.lower(fragment)
    while current and current ~= LocalPlayer.PlayerGui do
        if string.find(string.lower(current.Name), fragment, 1, true) then return true end
        current = current.Parent
    end
    return false
end

