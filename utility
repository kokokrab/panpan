local function visibleStarRewardsRoot()
    for _, root in ipairs(LocalPlayer.PlayerGui:GetChildren()) do
        local lowerName = string.lower(root.Name)
        if root:IsA("ScreenGui") and string.find(lowerName, "starreward", 1, true)
            and isActuallyVisible(root) then
            for _, descendant in ipairs(root:GetDescendants()) do
                if descendant:IsA("GuiObject") and isActuallyVisible(descendant)
                    and descendant.AbsoluteSize.X > 120 and descendant.AbsoluteSize.Y > 80 then
                    return root
                end
            end
        end
    end
end

local function starRewardsCloseButton(root)
    root = root or visibleStarRewardsRoot()
    if not root then return nil end
    local fallback
    local fallbackY = math.huge
    local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
    for _, button in ipairs(root:GetDescendants()) do
        if (button:IsA("TextButton") or button:IsA("ImageButton")) and isActuallyVisible(button) then
            local name = string.lower(button.Name)
            local text = string.lower(string.gsub(buttonText(button), "^%s*(.-)%s*$", "%1"))
            if string.find(name, "close", 1, true) or string.find(name, "exit", 1, true)
                or text == "x" or text == "×" then
                return button
            end

            local size = button.AbsoluteSize
            local position = button.AbsolutePosition
            local square = size.X >= 24 and size.X <= 90 and size.Y >= 24 and size.Y <= 90
                and math.abs(size.X - size.Y) <= 18
            local upperRight = position.X > viewport.X * 0.55 and position.Y < viewport.Y * 0.35
            if square and upperRight and position.Y < fallbackY then
                fallback = button
                fallbackY = position.Y
            end
        end
    end
    return fallback
end

local function frequentLocationPromptButton()
    local dialog = LocalPlayer.PlayerGui:FindFirstChild("DialogApp")
    if not dialog or not isActuallyVisible(dialog) then return nil end
    local copy = ""
    for _, descendant in ipairs(dialog:GetDescendants()) do
        if descendant:IsA("TextLabel") and isActuallyVisible(descendant) then
            copy ..= " " .. string.lower(descendant.Text)
        end
    end
    local normalized = string.gsub(copy, "[^%w]+", "")
    local isFrequentLocationPrompt = string.find(normalized, "youvechosenthisoptionalot", 1, true)
        and string.find(normalized, "gothereeverytime", 1, true)
    if not isFrequentLocationPrompt then return nil end
    return visibleButtonByText(dialog, "Yes") or visibleButtonByText(dialog, "YES")
end

local function defaultLocationConfirmationButton()
    local dialog = LocalPlayer.PlayerGui:FindFirstChild("DialogApp")
    if not dialog or not isActuallyVisible(dialog) then return nil end
    local copy = ""
