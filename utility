local function homeSpawnButton()
    local chooser = spawnChooserRoot()
    if not chooser then return nil end
    local known = child(chooser, "Choices", "Home", "Button")
    if known and isActuallyVisible(known) then return known end

    local best, bestScore
    for _, button in ipairs(chooser:GetDescendants()) do
        if (button:IsA("TextButton") or button:IsA("ImageButton")) and isActuallyVisible(button)
            and not hasNamedAncestor(button, "default") then
            local labels = { buttonText(button) }
            for _, descendant in ipairs(button:GetDescendants()) do
                if descendant:IsA("TextLabel") and isActuallyVisible(descendant) then
                    table.insert(labels, descendant.Text)
                end
            end

            local matchesHome = false
            for _, label in ipairs(labels) do
                local normalized = normalizedGuiText(label)
                if normalized == "home" or normalized == "rumah" then
                    matchesHome = true
                    break
                end
            end

            if matchesHome then
                local score = 0
                if hasNamedAncestor(button, "home") then score += 10 end
                if hasNamedAncestor(button, "choice") then score += 5 end
                if hasNamedAncestor(button, "spawn") or hasNamedAncestor(button, "location") then score += 3 end
                if not best or score > bestScore then best, bestScore = button, score end
            end
        end
    end
    return best
end

