end

local function enterWorld()
    LocalPlayer:WaitForChild("PlayerGui")
    local playStartedAt = os.clock()
    local playDeadline = playStartedAt + 30
    local clickedPlay = false
    repeat
        local playButton = newsPlayButton()
        if playButton then
            clickedPlay = true
            clickWrappedButton(playButton)
            if firesignal then
                pcall(firesignal, playButton.MouseButton1Click)
                pcall(firesignal, playButton.Activated)
            end
            task.wait(0.75)
            if newsPlayButton() then
                closeNewsAppDirectly()
                task.wait(0.25)
            end
            if newsPlayButton() == nil then break end
        else
            if os.clock() - playStartedAt >= 2
                and ReplicatedStorage:FindFirstChild("API")
                and newsPlayButton() == nil then
                break
            end
            task.wait(0.25)
        end
    until os.clock() >= playDeadline or not getgenv().AutoTradeRunning

    assert(newsPlayButton() == nil, "Could not close the Adopt Me news panel with Play")
    if clickedPlay then
        notify("Closed news panel with Play")
    end

    closeStartupPopups()

    local chooserDeadline = os.clock() + 30
    local chooserClearSince
    repeat
        local home = homeSpawnButton()
        if home then
            assert(clickWrappedButton(home), "Could not select Home")
            waitFor("location chooser to close after selecting Home", function()
                return not spawnChooserVisible()
            end, 10)
            notify("Spawned at Home")
            return waitFor("Adopt Me API", function()
                return ReplicatedStorage:FindFirstChild("API")
            end, 30)
        end
        if not spawnChooserVisible() and ReplicatedStorage:FindFirstChild("API") then
            chooserClearSince = chooserClearSince or os.clock()
            if os.clock() - chooserClearSince >= 2 then
                return ReplicatedStorage.API
            end
        else
            chooserClearSince = nil
        end
        task.wait(0.2)
    until os.clock() >= chooserDeadline or not getgenv().AutoTradeRunning

    assert(not spawnChooserVisible(), "Could not select Home from the location chooser")
    waitFor("Adopt Me API", function()
        return ReplicatedStorage:FindFirstChild("API")
    end, 30)
end

