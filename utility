-- ===================== ACCEPTING & SENDING TRADES =====================
local function currentTrade()
    local ownData, allData = playerData()
    return ownData.trade or allData.trade
end

local function tradeStage()
    local trade = currentTrade()
    return trade and trade.current_stage or nil
end

local function negotiationVisible()
    local app = LocalPlayer.PlayerGui:FindFirstChild("TradeApp")
    local frame = app and app:FindFirstChild("Frame")
    local negotiation = frame and frame:FindFirstChild("NegotiationFrame")
    return app and app.Enabled and frame and frame.Visible
        and negotiation and negotiation.Visible or false
end

local function offeredItemCount(playerName)
    local trade = currentTrade()
    if type(trade) ~= "table" then return 0 end
    local offer
    if playerName then
        local senderName = trade.sender and trade.sender.Name
        offer = senderName == playerName and trade.sender_offer or trade.recipient_offer
    else
        local isLocalSender = trade.sender and trade.sender.Name == LocalPlayer.Name
        offer = isLocalSender and trade.recipient_offer or trade.sender_offer
    end
    local items = type(offer) == "table" and offer.items or nil
    local count = 0
    for _ in pairs(type(items) == "table" and items or {}) do count += 1 end
    return count
end

local function dismissButtonIfPresent(text, seconds)
    local deadline = os.clock() + seconds
    repeat
        local button = visibleDialogButton(text)
        if button then
            assert(clickWrappedButton(button), "Could not click dialog button: " .. text)
            return true
        end
        task.wait(0.1)
    until os.clock() >= deadline
    return false
end

local function clearConfirmationWarnings()
    local deadline = os.clock() + 8
    local sawWarning = false
    repeat
        local button = visibleDialogButton("Next") or visibleDialogButton("I understand")
        if button then
            sawWarning = true
            assert(clickWrappedButton(button), "Could not advance confirmation warning")
            task.wait(0.3)
        elseif sawWarning or os.clock() > deadline - 6 then
            return
        else
            task.wait(0.1)
        end
    until os.clock() >= deadline
end

local function waitForStableOffer(senderName)
    local lastCount = -1
    local changedAt = os.clock()
    repeat
        local count = offeredItemCount(senderName)
        if count ~= lastCount then
            lastCount = count
            changedAt = os.clock()
        end
        if (not REQUIRE_ITEMS or count > 0) and os.clock() - changedAt >= OFFER_COOLDOWN then
            return count
        end
        assert(tradeStage() == "negotiation", "Trade left negotiation before the offer stabilized")
        task.wait(0.2)
    until not getgenv().AutoTradeRunning
    error("Stopped while waiting for offer")
end

local function waitForTradeClosed()
    waitFor("completed trade", function() return currentTrade() == nil end, 60)
end

local function receiveOneTrade(expectedSender)
    local acceptButton = visibleDialogButton("Accept")
    if not acceptButton then return nil end

    setStatus("Accepting incoming trade...", Color3.fromRGB(125, 211, 252))
    assert(clickWrappedButton(acceptButton), "Could not accept the trade request")
    dismissButtonIfPresent("Okay", 3)
    waitFor("negotiation window", function()
        return tradeStage() == "negotiation" and negotiationVisible()
    end)

    setStatus("Waiting for offer to stabilize...", Color3.fromRGB(253, 224, 71))
    local offered = waitForStableOffer(expectedSender)
    setStatus(("Accepting %d item(s)..."):format(offered), Color3.fromRGB(125, 211, 252))
    callRemote("TradeAPI/AcceptNegotiation")
    waitFor("confirmation stage", function() return tradeStage() == "confirmation" end)
    clearConfirmationWarnings()
    callRemote("TradeAPI/ConfirmTrade")
    waitForTradeClosed()
    closePetDiscoveryApp()
    task.wait(1)
    closePetDiscoveryApp()
    refreshEggCounter()

    setStatus(("Accepted trade (%d item(s))"):format(offered), Color3.fromRGB(134, 239, 172))
    notify(("Accepted trade (%d item(s))"):format(offered))
    return offered
end

local function sendEggBatch(receiver, batchSize)
    local beforeIds = crystalEggIds()
    assert(#beforeIds >= batchSize,
        ("Need %d Crystal Eggs for this batch; found %d"):format(batchSize, #beforeIds))

    callRemote("TradeAPI/SendTradeRequest", receiver)
    waitFor("receiver to accept trade", function()
        return tradeStage() == "negotiation" and negotiationVisible()
    end, 60)
    task.wait(0.5)

    for index = 1, batchSize do
        callRemote("TradeAPI/AddItemToOffer", beforeIds[index])
        task.wait(0.15)
    end

    task.wait(OFFER_COOLDOWN)
    callRemote("TradeAPI/AcceptNegotiation")
    waitFor("confirmation stage", function() return tradeStage() == "confirmation" end)
    clearConfirmationWarnings()
    callRemote("TradeAPI/ConfirmTrade")
    waitForTradeClosed()
    task.wait(1)

    local sent = #beforeIds - crystalEggCount()
    refreshEggCounter()
    assert(sent == batchSize,
        ("Sender verification failed: expected -%d, got -%d"):format(batchSize, sent))
    return sent
end

local updateActionButtons -- forward declaration

local function sendCrystalEggs(receiverName, targetAmount)
    if state.sending then
        setStatus("Already sending a batch!", Color3.fromRGB(251, 191, 36))
        return false
    end
    targetAmount = math.floor(tonumber(targetAmount) or DEFAULT_SEND_AMOUNT)
    if targetAmount <= 0 then
        setStatus("Amount must be greater than 0", Color3.fromRGB(248, 113, 113))
        return false
    end
    if not receiverName or receiverName == "" then
        setStatus("Select a user first", Color3.fromRGB(248, 113, 113))
        return false
    end

    local available = crystalEggCount()
    if available < targetAmount then
        setStatus(("Not enough eggs (%d / %d)"):format(available, targetAmount), Color3.fromRGB(248, 113, 113))
        return false
    end

    state.sending = true
    state.cancelSend = false
    if updateActionButtons then updateActionButtons() end

    local sent = 0
    local totalBatches = math.ceil(targetAmount / MAX_TRADE_SLOTS)
    local batchIndex = 0

    local ok, err = pcall(function()
        while sent < targetAmount and getgenv().AutoTradeRunning and not state.cancelSend do
            local receiver = Players:FindFirstChild(receiverName)
            assert(receiver, "Player left server: " .. receiverName)

            batchIndex += 1
            local batchSize = math.min(MAX_TRADE_SLOTS, targetAmount - sent)
            setStatus(("Batch %d/%d: sending %d to %s (%d/%d)"):format(
                batchIndex, totalBatches, batchSize, receiverName, sent, targetAmount
            ), Color3.fromRGB(125, 211, 252))

            sent += sendEggBatch(receiver, batchSize)
            if sent < targetAmount and not state.cancelSend then
                task.wait(1)
            end
        end
    end)

    state.sending = false
    refreshEggCounter()
    if updateActionButtons then updateActionButtons() end

    if not ok then
        warn("[AutoTrade] Send failed: " .. tostring(err))
        setStatus("Send error: " .. tostring(err), Color3.fromRGB(248, 113, 113))
        notify("Send stopped at " .. sent .. "/" .. targetAmount .. ": " .. tostring(err), 8)
        return false
    elseif state.cancelSend then
        state.cancelSend = false
        setStatus(("Cancelled (%d/%d sent)"):format(sent, targetAmount), Color3.fromRGB(251, 191, 36))
        notify(("Cancelled after sending %d/%d Crystal Eggs"):format(sent, targetAmount))
        return false
    else
        setStatus(("Sent %d/%d Crystal Eggs to %s"):format(sent, targetAmount, receiverName), Color3.fromRGB(134, 239, 172))
        notify(("Sent %d Crystal Eggs to %s!"):format(sent, receiverName))
        return true
    end
end

