local function startupPopupButton()
    local playerGui = LocalPlayer.PlayerGui
    local rewardsClose = starRewardsCloseButton()
    if rewardsClose then return rewardsClose, "star rewards close" end
    local locationYes = frequentLocationPromptButton()
    if locationYes then return locationYes, "frequent location yes" end
    local locationOkay = defaultLocationConfirmationButton()
    if locationOkay then return locationOkay, "default location okay" end
    for _, button in ipairs(playerGui:GetDescendants()) do
        if (button:IsA("TextButton") or button:IsA("ImageButton")) and isActuallyVisible(button) then
            local root = button:FindFirstAncestorOfClass("ScreenGui")
            if root and root.Name ~= "TradeApp" and root.Name ~= UI_NAME then
                local normalized = string.lower(string.gsub(buttonText(button), "^%s*(.-)%s*$", "%1"))
                normalized = string.gsub(normalized, "[%s!%.]+$", "")
                if SAFE_POPUP_TEXT[normalized] then return button, normalized end

                local lowerName = string.lower(button.Name)
                local parentName = string.lower(button.Parent and button.Parent.Name or "")
                local rootName = string.lower(root.Name)
                local closeControl = lowerName == "closebutton" or lowerName == "close_button"
                    or lowerName == "exitbutton" or lowerName == "exit_button"
                local popupContainer = string.find(parentName, "popup", 1, true)
                    or string.find(parentName, "modal", 1, true)
                    or string.find(parentName, "reward", 1, true)
                    or string.find(parentName, "news", 1, true)
                    or string.find(rootName, "reward", 1, true)
                    or string.find(rootName, "daily", 1, true)
                    or string.find(rootName, "popup", 1, true)
                    or string.find(rootName, "news", 1, true)
                if closeControl and popupContainer then return button, button.Name end
            end
        end
    end
end

local function popupIsGone(button)
    return not button or not button.Parent or not isActuallyVisible(button)
end

local function closeStarRewardsApp()
    local ok, result = pcall(function()
        local Fsys = require(ReplicatedStorage:WaitForChild("Fsys"))
        local UIManager = Fsys.load("UIManager")
        UIManager.set_app_visibility("StarRewardsApp", false)
        return true
    end)
    if not ok then
        warn("[AutoTrade] Could not close StarRewardsApp through UIManager: " .. tostring(result))
    end
    return ok and result
end

local function dismissStartupPopup(button, label)
    local root = button and button:FindFirstAncestorOfClass("ScreenGui")
    local normalizedLabel = string.lower(tostring(label or ""))
    local isStarRewards = normalizedLabel == "claim" or normalizedLabel == "klaim"
        or normalizedLabel == "collect" or normalizedLabel == "ambil"
        or normalizedLabel == "awesome" or normalizedLabel == "luar biasa"
        or normalizedLabel == "star rewards close"
        or (root and string.find(string.lower(root.Name), "starreward", 1, true))

    local function fullyDismissed()
        if isStarRewards then return visibleStarRewardsRoot() == nil end
        return popupIsGone(button)
    end

    clickWrappedButton(button)
    task.wait(0.35)
    if fullyDismissed() then return true end

    physicallyClickButton(button)
    task.wait(0.75)
    if fullyDismissed() then return true end

    if isStarRewards then
        closeStarRewardsApp()
        if root and root.Name == "DialogApp" then
            pcall(function()
                local UIManager = require(ReplicatedStorage:WaitForChild("Fsys")).load("UIManager")
                UIManager.set_app_visibility("DialogApp", false)
            end)
        end
        task.wait(0.25)
        if fullyDismissed() then return true end

        local currentClose = starRewardsCloseButton()
        if currentClose then
            clickWrappedButton(currentClose)
            physicallyClickButton(currentClose)
            task.wait(0.5)
        end
        return visibleStarRewardsRoot() == nil
    end

    return false
end

local function closeStartupPopups()
    local deadline = os.clock() + 30
    local clearSince
    local dismissed = 0
    repeat
        local button, label = startupPopupButton()
        if button then
            clearSince = nil
            if dismissStartupPopup(button, label) then
                dismissed += 1
                print(("[AutoTrade] Dismissed startup popup: %s"):format(label))
            else
                warn(("[AutoTrade] Popup did not close after click: %s"):format(label))
            end
            task.wait(0.15)
        else
            clearSince = clearSince or os.clock()
            if os.clock() - clearSince >= 3 then
                if dismissed > 0 then
                    notify(("Startup popups cleared (%d dismissed)"):format(dismissed))
                end
                return
            end
            task.wait(0.15)
        end
    until os.clock() >= deadline or not getgenv().AutoTradeRunning
    error("Startup popup cleanup did not reach a stable clear screen")
end

